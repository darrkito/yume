# Mercado Pago — obtén tus credenciales en:
# https://www.mercadopago.com.mx/developers/panel/app
# Usa las credenciales de PRUEBA mientras desarrollas, y las de PRODUCCIÓN
# solo cuando el sitio esté listo para cobrar de verdad.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Supabase — nombres exactos que ya inyecta la integración de Vercel
# (Storage/Database -> Supabase). No renombrar: si se renombran aquí,
# dejan de coincidir con lo que Vercel realmente provee en producción.
Supa_Store_Stor_SUPABASE_URL=
Supa_Store_Stor_SUPABASE_SERVICE_ROLE_KEY=

# Gmail — para los correos de confirmación (negocio + cliente) al aprobarse
# un pago. Sin esto, el checkout y la orden en Supabase funcionan igual;
# solo no se manda el correo (falla controlada, no rompe el pago).
# GMAIL_APP_PASSWORD se genera en myaccount.google.com/security -> Verificación
# en 2 pasos -> Contraseñas de aplicaciones (no es tu contraseña normal).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Mercado Pago -> Webhooks -> "Clave secreta". Con esto el webhook valida la
# firma x-signature; sin ella funciona pero no verifica (solo aviso en logs).
MERCADOPAGO_WEBHOOK_SECRET=

# Secreto del cron de carrito abandonado (Vercel lo manda como Bearer). Sin
# esto el endpoint responde 503 y el recordatorio nunca corre.
CRON_SECRET=

# Opcional, solo para pruebas locales/preview: base de back_urls/webhook de
# Mercado Pago (por defecto https://studioyume.mx). Con localhost no se manda
# notification_url.
CHECKOUT_BASE_URL=
